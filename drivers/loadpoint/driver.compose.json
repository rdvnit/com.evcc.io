{
  "name": {
    "en": "Charging point"
  },
  "class": "evcharger",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "capabilities": [
    "evcc_charge_mode",
    "evcc_target_soc",
    "measure_battery",
    "measure_power",
    "meter_power",
    "evcc_connected",
    "evcc_charging",
    "evcc_vehicle_range"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Charging power"
      }
    },
    "meter_power": {
      "title": {
        "en": "Session energy"
      }
    },
    "measure_battery": {
      "title": {
        "en": "Vehicle battery"
      }
    }
  },
  "energy": {
    "evCharger": true,
    "meterPowerImportedCapability": "meter_power",
    "batteries": [
      "OTHER"
    ]
  },
  "images": {
    "small": "/drivers/loadpoint/assets/images/small.png",
    "large": "/drivers/loadpoint/assets/images/large.png",
    "xlarge": "/drivers/loadpoint/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "connect",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "host",
      "type": "text",
      "label": {
        "en": "evcc URL"
      },
      "value": "http://",
      "hint": {
        "en": "Base URL of your evcc instance, e.g. http://192.168.1.50:7070"
      }
    },
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Password (optional)"
      },
      "value": "",
      "hint": {
        "en": "Only needed if your evcc instance has a login password configured"
      }
    },
    {
      "id": "pollInterval",
      "type": "number",
      "label": {
        "en": "Update interval (seconds)"
      },
      "value": 10,
      "min": 5,
      "max": 300,
      "hint": {
        "en": "How often Homey polls evcc for updates"
      }
    }
  ]
}